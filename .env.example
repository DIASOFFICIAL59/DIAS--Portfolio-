# RESEND EMAIL API KEY
# 1. Go to https://resend.com/ and create an account.
# 2. Add your domain, or use the default onboarding address to test.
# 3. Generate an API key and paste it below.
RESEND_API_KEY=re_your_api_key_here

# API URL
# Leave blank for production if frontend/backend are on the same origin,
# or set to http://localhost:3001 during local development.
VITE_API_URL=http://localhost:3001
